# ==============================================================
# CampusFind - Environment Configuration Template
# Copy this file to '.env' and fill in values for your environment.
# NEVER commit the actual '.env' file with secrets to Git!
# ==============================================================

# Application Environment: 'development' or 'production'
CAMPUSFIND_ENV=development

# Security: Secret key for signing session cookies and CSRF tokens.
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-strong-random-64-character-hex-key-in-production

# Cookie Security: Set to 'true' in production HTTPS; 'false' for local HTTP development.
SESSION_COOKIE_SECURE=false

# ==============================================================
# Database Configuration (Dual Support: SQLite vs PostgreSQL)
# ==============================================================
# Local SQLite Database File Path (active when DATABASE_URL is unset)
DATABASE_PATH=database/campusfind.db

# Cloud PostgreSQL Connection URL (e.g. Supabase Session Pooler or Direct Connection)
# When set, CampusFind automatically uses PostgreSQL instead of SQLite.
# Example: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Upload Folder: Fallback / local persistent storage for uploaded item photographs.
UPLOAD_FOLDER=static/uploads

# Rate Limiter Storage: 'memory://' for single instance, or 'redis://localhost:6379' for clusters.
RATELIMIT_STORAGE_URI=memory://

# Reverse Proxy / Trusted Proxy: Set to 'true' if running behind Nginx, Caddy, or Cloudflare.
BEHIND_PROXY=false

# ==============================================================
# Supabase Storage Configuration (Phase 8A)
# ==============================================================
# Project URL (e.g., https://your-project-ref.supabase.co)
SUPABASE_URL=

# Service Role Secret Key (Server-side only for private bucket access; NEVER expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=

# Existing private bucket name in Supabase Storage
SUPABASE_BUCKET=campusfind-uploads

# Expiration for temporary signed URLs in seconds (default: 3600 = 1 hour)
SUPABASE_SIGNED_URL_EXPIRY=3600

# Optional: In development, allow falling back to local storage if Supabase upload fails ('true' or 'false')
SUPABASE_FALLBACK_LOCAL=false
